# Copie para .env e ajuste se necessário. Todos os valores têm default no
# código/compose, então o quickstart funciona sem .env.

# Kafka (listener EXTERNAL, alcançável do host)
KAFKA_BOOTSTRAP=localhost:9094
KAFKA_TOPIC=cpu_data
KAFKA_GROUP_ID=cpu_group

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=baldinho

# Producer
SAMPLE_INTERVAL=1
